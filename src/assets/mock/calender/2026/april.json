    {
      "id": "2026-04-14",
      "day": 14,
      "hinduDay": {
        "en": "Dwadashi",
        "hi": "द्वादशी",
        "gu": "બારસ"
      },
      "hinduTithiShort": {
        "en": "K-12",
        "hi": "कृ. 12",
        "gu": "વદ 12"
      },
      "paksha": "krishna",
      "isHighlighted": true,
      "events": [
        {
          "id": "evt_2026_04_14_1",
          "title": {
            "hi": "मेष संक्रान्तिः। सतुआ गोपीवल्लभ या राजभोग में। पुण्यकाल आज सूर्योदय सूं दोपहर 1 बजके 33 मिनिट पर्यन्त है। तामे भी प्रातः 7 बजके 33 मिनिट सूं अति मुख्य पुण्यकाल है। श्री कूं भोग धरे पीछे दान श्राद्धादि करने। अबके यह संक्रान्ति 12 मंगल कूं प्रातः 9 बजके 33 मिनिट पर बैठी है। तासूं पुण्यकाल आज मान्यो जायेगो।",
            "gu": "મેષ સંક્રાન્તિઃ. સતુઆ ગોપીવલ્લભ યા રાજભોગ મેં. પુણ્યકાલ આજ સૂર્યોદય સૂં દોપહર 1 બજકે 33 મિનિટ પર્યન્ત હૈ. તામે ભી પ્રાતઃ 7 બજકે 33 મિનિટ સૂં અતિ મુખ્ય પુણ્યકાલ હૈ. શ્રી કૂં ભોગ ધરે પીછે દાન શ્રાદ્ધાદિ કરને. અબકે યહ સંક્રાન્તિ 12 મંગલ કૂં પ્રાતઃ 9 બજકે 33 મિનિટ પર બૈઠી હૈ. તાસૂં પુણ્યકાલ આજ માન્યો જાયેગો.",
            "en": "Mesh sankrantih. Satuaa gopeevallabh ya rajabhog men. Punyakal aaj sooryoday soon dopahar 1 bajake 33 minit paryant hai. Tame bhee pratah 7 bajake 33 minit soon ati mukhy punyakal hai. Shri koon bhog dhare peechhe dan shraddhadi karane. Abake yah sankranti 12 mangal koon pratah 9 bajake 33 minit par baithee hai. Tasoon punyakal aaj manyo jayego."
          }
        }
      ]
    },
